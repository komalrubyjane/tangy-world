# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API Keys in the Supabase dashboard).
# The browser gets ONLY the public key: the publishable key (sb_publishable_...),
# or the legacy anon key for older projects / the local stack. Never put a
# secret (sb_secret_...) or service_role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, still read when VITE_SUPABASE_PUBLISHABLE_KEY is empty:
VITE_SUPABASE_ANON_KEY=

# Loading the demo dataset into a hosted REVIEW project (scripts/demo-data.sh,
# DEMO_TARGET=review) reads these from .env.review.local (gitignored). They are
# server-side credentials: never VITE_ variables, never committed.
#   SUPABASE_DB_URL       postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#   SUPABASE_SECRET_KEY   sb_secret_... (or the legacy service_role key)

# Not required by the app itself — the razorpay-create-order Edge Function
# returns its own RAZORPAY_KEY_ID (set as a function secret, see
# supabase/README.md) in its response, so the frontend never needs its own
# copy. Left here only if you want a client-side reference to which key is
# in use. The SECRET key must never go in this file, or any frontend code —
# it belongs only in Supabase Edge Function secrets (`supabase secrets set`).
VITE_RAZORPAY_KEY_ID=

# Email (every Edge Function sends through supabase/functions/_shared/email.ts).
# These are Supabase Edge Function SECRETS set via `supabase secrets set` —
# never VITE_ variables, never referenced anywhere in src/.
#   EMAIL_PROVIDER   resend (default) | log (development: logs recipient +
#                    subject only) | disabled | mailpit (LOCAL STACK ONLY).
#   RESEND_API_KEY   Resend API key. Until it is set, email is "not
#                    configured": nothing is sent, queued notification emails
#                    stay queued (not failed), and ticket/approval emails show
#                    "Email is not configured yet." for the admin to resend later.
#   EMAIL_FROM       sender, e.g. "Tangy Sessions <hello@tangysessions.com>"
#                    (the old name RESEND_FROM_EMAIL is still accepted). The
#                    domain must be verified in Resend before going live.
#   EMAIL_REPLY_TO   optional reply-to address.
#   SITE_URL         the deployed site's origin (e.g. https://tangysessions.com);
#                    email links are SITE_URL + the app path.
#   CRON_SECRET      shared secret your scheduler sends as `x-cron-secret` to
#                    send-notification-emails (drains email_outbox). Use a long
#                    random value, or call it with the service-role key.
#   ALLOWED_ORIGINS  browser origins allowed by the Edge Functions' CORS (comma
#                    separated, canonical origin first); defaults to SITE_URL.
#   MAILPIT_URL      LOCAL ONLY, with EMAIL_PROVIDER=mailpit
#                    (defaults to http://host.docker.internal:54324).
# Never set EMAIL_PROVIDER=mailpit/log or MAILPIT_URL in production.
#   SUPABASE_SERVICE_ROLE_KEY / SUPABASE_URL / SUPABASE_ANON_KEY are provided
#   automatically to every Edge Function by Supabase — no need to set them.
#
# Payments (razorpay-create-order / -verify-payment / -webhook) — Edge Function
# secrets: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET.
# Without the key id/secret, checkout answers "Online payment is not available
# yet" (HTTP 503) and no pending booking is left holding seats.
#
# Storage needs no environment variables: the private buckets (artist-media,
# event-documents, sponsor-assets) and the public artist-avatars and
# content-media buckets are created by the migrations, with access enforced
# by their policies.

# DEMO-ONLY — see src/config/demoAdmin.js. Set to 'true' only in a local/dev
# build to show a "TEAM DEMO / ENTER DEMO ADMIN" option on the admin sign-in
# screen. This is a feature flag, NOT a credential — it grants no real
# database access on its own (Demo Admin mode has no Supabase session at
# all, so RLS blocks every privileged read/write regardless of this flag).
# Leave unset/false in any deployed build, and never set it in production.
# `vite build` refuses to run while it is 'true' (set TANGY_ALLOW_DEMO_BUILD=1 only
# for a deliberate local demo build).
VITE_DEMO_ADMIN_ENABLED=

# DEVELOPMENT-ONLY role selector (src/admin/dev/, vite.config.js).
# `npm run dev` opens /admin on a role selector with development identities
# (Super Admin / Admin / Staff, plus the artist, sponsor, vendor, venue host
# and volunteer portals — all @tangy.local). It is compiled out of every
# `vite build` (set TANGY_DEV_TOOLS=off to hide it in dev too). Console roles
# work mock-only: the real permission system drives nav and route guards, but
# data requests are unauthenticated. Partner portals, and real data + RLS for
# every role, need a LOCAL Supabase stack
# in .env.development.local (gitignored), e.g. from `npx supabase status`:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<local anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<local service_role key>   # dev server only, never VITE_
# The dev server refuses to create sessions unless the URL is localhost.
# Never put a real project's service_role key here.
