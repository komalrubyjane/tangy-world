# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Not required by the app itself — the razorpay-create-order Edge Function
# returns its own RAZORPAY_KEY_ID (set as a function secret, see
# supabase/README.md) in its response, so the frontend never needs its own
# copy. Left here only if you want a client-side reference to which key is
# in use. The SECRET key must never go in this file, or any frontend code —
# it belongs only in Supabase Edge Function secrets (`supabase secrets set`).
VITE_RAZORPAY_KEY_ID=

# Approval-email Edge Function (supabase/functions/send-approval-email) —
# these are Supabase Edge Function SECRETS, set via `supabase secrets set`,
# never VITE_ variables, never referenced anywhere in src/. The function
# reads them server-side only; the browser never sees RESEND_API_KEY.
#   RESEND_API_KEY      — Resend API key used to send approval emails.
#   RESEND_FROM_EMAIL    — optional, defaults to "Tangy Sessions <hello@tangysessions.com>".
#   SITE_URL             — the deployed site's origin (e.g. https://tangysessions.com),
#                           used to build the "OPEN YOUR TANGY PORTAL" link in the email.
#   SUPABASE_SERVICE_ROLE_KEY / SUPABASE_URL / SUPABASE_ANON_KEY are provided
#   automatically to every Edge Function by Supabase — no need to set them.

# DEMO-ONLY — see src/config/demoAdmin.js. Set to 'true' only in a local/dev
# build to show a "TEAM DEMO / ENTER DEMO ADMIN" option on the admin sign-in
# screen. This is a feature flag, NOT a credential — it grants no real
# database access on its own (Demo Admin mode has no Supabase session at
# all, so RLS blocks every privileged read/write regardless of this flag).
# Leave unset/false in any deployed build, and never set it in production.
VITE_DEMO_ADMIN_ENABLED=

# DEVELOPMENT-ONLY role selector (src/admin/dev/, vite.config.js).
# `npm run dev` opens /admin on a role selector with development identities
# (Super Admin / Admin / Staff, plus the artist, sponsor, vendor, venue host
# and volunteer portals — all @tangy.local). It is compiled out of every
# `vite build` (set TANGY_DEV_TOOLS=off to hide it in dev too). Console roles
# work mock-only: the real permission system drives nav and route guards, but
# data requests are unauthenticated. Partner portals, and real data + RLS for
# every role, need a LOCAL Supabase stack
# in .env.development.local (gitignored), e.g. from `npx supabase status`:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<local anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<local service_role key>   # dev server only, never VITE_
# The dev server refuses to create sessions unless the URL is localhost.
# Never put a real project's service_role key here.
