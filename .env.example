# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay checkout key id (public, safe for the frontend). Use a test key (rzp_test_...)
# until you're ready to go live. The secret key must never go in this file or any
# frontend code — it belongs only in a Supabase Edge Function environment variable.
VITE_RAZORPAY_KEY_ID=
